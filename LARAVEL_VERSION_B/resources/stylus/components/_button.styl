.button
  display: inline-flex
  align-items: center
  justify-content: center
  gap: 0.5rem
  border-radius: $radius-md
  font-size: 0.875rem
  font-weight: 500
  line-height: 1
  border: 1px solid transparent
  transition: all 0.2s ease
  white-space: nowrap
  padding: 0.5rem 1rem
  height: 2.5rem

  &:focus-visible
    outline: 2px solid $gp-accent
    outline-offset: 2px

  &--primary
    background-color: $gp-primary
    color: white
    &:hover
      background-color: $gp-primary-light

  &--outline
    background-color: transparent
    border-color: $gp-border
    color: $gp-text
    &:hover
      background-color: $gp-background

  &--ghost
    background-color: transparent
    color: $gp-text
    &:hover
      background-color: $gp-muted

  &--accent
    background-color: $gp-accent
    color: white
    box-shadow: 0 4px 14px rgba($gp-accent, 0.25)
    &:hover
      background-color: $gp-accent-light

  &--lg
    height: 2.75rem
    padding: 0.5rem 1.5rem
    font-size: 0.875rem

  &--sm
    height: 2rem
    padding: 0.25rem 0.75rem
    font-size: 0.8125rem

  &--icon
    width: 2.5rem
    padding: 0

  &--full
    width: 100%

  &:disabled
    opacity: 0.5
    pointer-events: none

  svg
    flex-shrink: 0
