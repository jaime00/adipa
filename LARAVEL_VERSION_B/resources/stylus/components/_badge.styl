.badge
  display: inline-flex
  align-items: center
  border-radius: 9999px
  font-size: 0.75rem
  font-weight: 500
  line-height: 1
  padding: 0.25rem 0.625rem
  border: 1px solid transparent
  white-space: nowrap

  &--cartaceo
    background-color: $badge-cartaceo
    color: white

  &--digitale
    background-color: $badge-digitale
    color: white

  &--corso
    background-color: $badge-corso
    color: white

  &--in-presenza
    background-color: $badge-presenza
    color: white

  &--tag
    background-color: transparent
    border-color: $gp-accent
    color: $gp-accent
    font-weight: 600

  &--secondary
    background-color: $gp-secondary
    color: $gp-primary
    font-weight: 400
    padding: 0.125rem 0.625rem

  &--hero
    background-color: rgba(255, 255, 255, 0.1)
    color: $gp-accent-light
    border-color: rgba(255, 255, 255, 0.15)
    backdrop-filter: blur(4px)
    text-transform: uppercase
    letter-spacing: 0.2em
    font-weight: 600
    font-size: 0.75rem
    padding: 0.25rem 0.75rem
