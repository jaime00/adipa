.mobile-menu
  &__overlay
    position: fixed
    inset: 0
    z-index: 50
    background-color: rgba(0, 0, 0, 0.5)
    opacity: 0
    visibility: hidden
    transition: opacity 0.3s ease, visibility 0.3s ease

    &--open
      opacity: 1
      visibility: visible

  &__drawer
    position: fixed
    top: 0
    left: 0
    bottom: 0
    z-index: 51
    width: 18rem
    background-color: $gp-surface
    transform: translateX(-100%)
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)
    display: flex
    flex-direction: column
    overflow-y: auto

    &--open
      transform: translateX(0)

  &__header
    padding: 1rem 1.5rem
    border-bottom: 1px solid $gp-border

  &__body
    padding: 1rem 1rem
    display: flex
    flex-direction: column
    gap: 1rem

  &__separator
    height: 1px
    background-color: $gp-border

  &__nav
    display: flex
    flex-direction: column
    gap: 0.25rem

  &__link
    display: block
    padding: 0.5rem 0.75rem
    font-size: 0.875rem
    font-weight: 500
    color: $gp-text
    border-radius: $radius-md
    transition: background-color 0.2s ease

    &:hover
      background-color: $gp-muted

  +tablet()
    &__overlay, &__drawer
      display: none
