.toast
  position: fixed
  bottom: 1.5rem
  right: 1.5rem
  z-index: 100
  display: flex
  align-items: center
  gap: 0.75rem
  border-radius: $radius-xl
  background-color: $gp-text
  color: white
  padding: 1rem 1.25rem
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3)
  transform: translateY(40px)
  opacity: 0
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease
  pointer-events: none

  &--visible
    transform: translateY(0)
    opacity: 1
    pointer-events: auto

  &__icon
    flex-shrink: 0
    width: 1.25rem
    height: 1.25rem
    color: #34D399

  &__message
    font-size: 0.875rem
    font-weight: 500

  &__close
    margin-left: 0.5rem
    flex-shrink: 0
    padding: 0.25rem
    border-radius: $radius-md
    background: none
    border: none
    color: white
    cursor: pointer
    transition: background-color 0.2s ease
    display: flex
    align-items: center
    justify-content: center

    &:hover
      background-color: rgba(255, 255, 255, 0.1)

    svg
      width: 1rem
      height: 1rem
