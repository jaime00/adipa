.product-grid__tabs
  display: flex
  align-items: center
  gap: 0
  overflow-x: auto
  overflow-y: hidden
  border-bottom: 1px solid $gp-border
  -ms-overflow-style: none
  scrollbar-width: none
  &::-webkit-scrollbar
    display: none

  +tablet()
    justify-content: center

.product-grid__tab
  position: relative
  padding: 0.5rem 1rem
  font-size: 0.875rem
  font-weight: 500
  color: $gp-text-light
  background: none
  border: none
  border-bottom: 2px solid transparent
  white-space: nowrap
  flex-shrink: 0
  transition: color 0.2s ease, border-color 0.2s ease
  cursor: pointer

  &:hover
    color: $gp-text

  &--active
    color: $gp-text
    border-bottom-color: $gp-accent

  &:focus-visible
    outline: 2px solid $gp-accent
    outline-offset: -2px
