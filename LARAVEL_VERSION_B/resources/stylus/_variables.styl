// Colors
$gp-primary = #1B4F8A
$gp-primary-light = #2563A8
$gp-primary-dark = #153D6B
$gp-text = #0F2D52
$gp-text-light = #3B6B9A
$gp-accent = #0EA5E9
$gp-accent-light = #38BDF8
$gp-accent-dark = #0284C7
$gp-background = #EFF6FF
$gp-surface = #FFFFFF
$gp-error = #DC2626
$gp-success = #16A34A
$gp-border = #BFD3EA
$gp-muted = #DBEAFE
$gp-secondary = #E0EDFC

// Badge colors
$badge-cartaceo = #1E40AF
$badge-digitale = #0369A1
$badge-corso = #15803D
$badge-presenza = #B45309

// Shadows
$shadow-card = 0 1px 3px rgba(15, 45, 82, 0.08), 0 1px 2px rgba(15, 45, 82, 0.06)
$shadow-card-hover = 0 10px 25px rgba(15, 45, 82, 0.12), 0 4px 10px rgba(15, 45, 82, 0.08)

// Breakpoints
$tablet = 768px
$desktop = 1280px

// Radius
$radius = 0.625rem
$radius-sm = 0.375rem
$radius-md = 0.5rem
$radius-lg = 0.625rem
$radius-xl = 0.875rem
$radius-2xl = 1.125rem
