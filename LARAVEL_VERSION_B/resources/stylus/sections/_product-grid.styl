.product-grid
  padding: 4rem 0

  +tablet()
    padding: 6rem 0

  &__container
    container()

  &__tabs-wrapper
    margin-top: 2.5rem
    display: flex
    justify-content: center

  &__grid
    margin-top: 2.5rem
    display: grid
    gap: 1.5rem
    grid-template-columns: 1fr

    +tablet()
      grid-template-columns: repeat(2, 1fr)

    +desktop()
      grid-template-columns: repeat(3, 1fr)

  &__empty
    margin-top: 4rem
    text-align: center
    color: $gp-text-light
    display: none

    &--visible
      display: block

.product-card
  display: flex
  flex-direction: column
  height: 100%
  min-width: 360px
  padding: 1rem
  gap: 1rem
  background-color: $gp-surface
  border: 1px solid $gp-border
  border-radius: $radius-xl
  box-shadow: $shadow-card
  transition: box-shadow 0.3s ease

  &:hover
    box-shadow: $shadow-card-hover

  &__image-wrapper
    position: relative
    aspect-ratio: 3/2
    overflow: hidden
    border-radius: $radius-lg

  &__image
    width: 100%
    height: 100%
    object-fit: cover

  &__body
    display: flex
    flex: 1
    flex-direction: column
    gap: 0.75rem

  &__name
    font-size: 1rem
    font-weight: 700
    color: $gp-text
    line-height: 1.3
    display: -webkit-box
    -webkit-line-clamp: 2
    -webkit-box-orient: vertical
    overflow: hidden

  &__author
    margin-top: 0.25rem
    font-size: 0.875rem
    color: $gp-text-light
    display: -webkit-box
    -webkit-line-clamp: 1
    -webkit-box-orient: vertical
    overflow: hidden

  &__meta
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 0.5rem

  &__rating
    display: flex
    align-items: center
    gap: 0.25rem

  &__star
    width: 0.875rem
    height: 0.875rem
    color: #FBBF24

  &__rating-value
    font-size: 0.875rem
    font-weight: 500
    color: $gp-text

  &__review-count
    font-size: 0.875rem
    color: $gp-text-light

  &__badges
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 0.375rem
    font-size: 0.75rem

  &__footer
    display: flex
    flex-wrap: wrap
    align-items: center
    justify-content: space-between
    gap: 0.5rem
    padding-top: 0.5rem

  &__prices
    display: flex
    align-items: baseline
    gap: 0.5rem

  &__price
    font-size: 1.125rem
    font-weight: 700
    color: $gp-text

  &__original-price
    font-size: 0.875rem
    color: $gp-text-light
    text-decoration: line-through
