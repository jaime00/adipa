.contact
  padding: 4rem 0
  background-color: $gp-surface

  +tablet()
    padding: 6rem 0

  &__container
    container()

  &__grid
    margin-top: 3.5rem
    display: grid
    gap: 2rem
    align-items: stretch

    +tablet()
      grid-template-columns: repeat(2, 1fr)

  &__form-card
    height: 100%

  &__form
    display: flex
    flex-direction: column
    gap: 1rem

  &__field
    display: flex
    flex-direction: column
    gap: 0.375rem

  &__label
    font-size: 0.875rem
    font-weight: 500
    color: $gp-text

  &__error
    font-size: 0.8125rem
    color: $gp-error

  &__info-column
    display: flex
    flex-direction: column
    gap: 1.5rem
    height: 100%

  &__info-grid
    display: grid
    grid-template-columns: repeat(2, 1fr)
    gap: 1.25rem

  &__info-item
    display: flex
    gap: 0.75rem

    &--full
      grid-column: span 2

  &__info-icon
    display: flex
    width: 2.5rem
    height: 2.5rem
    flex-shrink: 0
    align-items: center
    justify-content: center
    border-radius: $radius-lg
    background-color: rgba($gp-primary, 0.1)

    svg
      color: $gp-primary
      width: 1.25rem
      height: 1.25rem

  &__info-title
    font-weight: 700
    color: $gp-text

  &__info-text
    margin-top: 0.25rem
    font-size: 0.875rem
    color: $gp-text-light

  &__map-card
    flex: 1
    overflow: hidden
    padding: 0
    border-radius: $radius-xl
    border: 1px solid $gp-border
    background: $gp-surface
    box-shadow: $shadow-card

    iframe
      width: 100%
      height: 100%
      min-height: 220px
      border: 0
